# ══════════════════════════════════════════════════════════════
#   STRAPI — VARIABLES D'ENVIRONNEMENT
# ══════════════════════════════════════════════════════════════
# Copier vers .env et renseigner. .env n'est jamais commité.
# Générer les secrets : `openssl rand -base64 32` (un par clé).

# ── Serveur ──
HOST=0.0.0.0
PORT=1337

# ── Secrets (OBLIGATOIRE de régénérer avant tout déploiement) ──
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ── Base de données ──
# Par défaut SQLite (fichier local, zéro configuration) — suffisant pour
# démarrer et pour le développement.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Pour PostgreSQL sur le VPS (phase d'intégration) : passer DATABASE_CLIENT
# à "postgres", installer le pilote (`npm i pg`), et renseigner :
# DATABASE_CLIENT=postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=darsafia
# DATABASE_USERNAME=darsafia
# DATABASE_PASSWORD=
# DATABASE_SSL=false
