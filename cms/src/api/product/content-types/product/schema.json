{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Parfum",
    "description": "Une création du catalogue."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brand.brand",
      "inversedBy": "products"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "story": {
      "type": "text",
      "description": "Récit éditorial, plus long que la description."
    },
    "gender": {
      "type": "enumeration",
      "enum": ["femme", "homme", "unisexe"],
      "required": true
    },
    "family": {
      "type": "enumeration",
      "enum": ["floral", "amber", "woody", "fresh", "gourmand", "spicy"],
      "required": true
    },
    "secondaryFamilies": {
      "type": "json",
      "description": "Familles secondaires, pour le filtrage transversal. Tableau de valeurs de `family`."
    },
    "notes": {
      "type": "component",
      "component": "catalog.product-note",
      "repeatable": true
    },
    "variants": {
      "type": "component",
      "component": "catalog.variant",
      "repeatable": true,
      "required": true,
      "min": 1
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos"]
    },
    "concentration": {
      "type": "string"
    },
    "longevityHours": {
      "type": "integer",
      "min": 0,
      "description": "Tenue en heures. Numérique pour permettre le tri."
    },
    "sillage": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "description": "Puissance du sillage, de 1 (intime) à 5 (puissant)."
    },
    "seasons": {
      "type": "json",
      "description": "Tableau : printemps, ete, automne, hiver, toutes."
    },
    "occasions": {
      "type": "json",
      "description": "Tableau : jour, soir, ceremonie, bureau, quotidien."
    },
    "badge": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "newArrival": {
      "type": "boolean",
      "default": false
    },
    "bestseller": {
      "type": "boolean",
      "default": false
    },
    "collections": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::collection.collection",
      "mappedBy": "products"
    },
    "seo": {
      "type": "component",
      "component": "catalog.seo",
      "repeatable": false
    }
  }
}
