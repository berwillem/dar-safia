{
  "kind": "collectionType",
  "collectionName": "fragrance_notes",
  "info": {
    "singularName": "fragrance-note",
    "pluralName": "fragrance-notes",
    "displayName": "Note olfactive",
    "description": "Une matière première (rose, jasmin, vétiver…). Entité à part pour relier les parfums qui la partagent."
  },
  "options": {
