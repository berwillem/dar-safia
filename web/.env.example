# ══════════════════════════════════════════════
#   DAR SAFIA — VARIABLES D'ENVIRONNEMENT (app Next)
# ══════════════════════════════════════════════
# Copiez vers .env.local pour surcharger. Jamais commité.

# ── WhatsApp ──
# NEXT_PUBLIC_ est inclus dans le bundle client : aucun secret ici.
# Laissé vide, le numéro réel codé dans src/lib/whatsapp.ts s'applique.
NEXT_PUBLIC_WHATSAPP_PHONE=

# ── Source du catalogue ──
# "static" (défaut) : sert web/src/data/*.json, généré depuis catalog-data.js.
# "strapi"          : lit l'API du CMS. Nécessite STRAPI_URL + STRAPI_API_TOKEN.
CATALOG_SOURCE=static

# ── Strapi (utilisé seulement si CATALOG_SOURCE=strapi) ──
# Ces variables sont SERVEUR (pas de préfixe NEXT_PUBLIC) : le token n'est
# jamais exposé au navigateur.
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
# Durée de mise en cache Next des réponses Strapi, en secondes (défaut 300).
STRAPI_REVALIDATE=300
